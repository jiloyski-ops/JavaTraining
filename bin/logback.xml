<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ========================= -->
    <!-- Console Appender          -->
    <!-- ========================= -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ========================================= -->
    <!-- Daily Rolling File Appender (NEW)         -->
    <!-- Current file: logs/bank-app.log           -->
    <!-- Archive: logs/bank-app-YYYY-MM-DD.log     -->
    <!-- Keep 30 days / Max size 1GB               -->
    <!-- ========================================= -->
    <appender name="DAILY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/bank-app.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Daily archive -->
            <fileNamePattern>logs/bank-app-%d{yyyy-MM-dd}.log</fileNamePattern>

            <!-- Keep 30 days -->
            <maxHistory>30</maxHistory>

            <!-- Total log storage cap -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ========================= -->
    <!-- Root Logger               -->
    <!-- Level: INFO               -->
    <!-- ========================= -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="DAILY_FILE"/>
    </root>

</configuration>
