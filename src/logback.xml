<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- Create ./logs folder if missing (Logback 1.5 creates parents automatically on write;
       if your environment doesn't, keep the 'logs' folder ready) -->
  <property name="LOG_DIR" value="logs" />
  <property name="LOG_FILE" value="${LOG_DIR}/app.log" />

  <!-- 1) Console appender with SHORT time: HH:mm:ss.SSS -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- 2) File appender with FULL date: yyyy-MM-dd HH:mm:ss.SSS -->
  <appender name="FILE" class="ch.qos.logback.core.FileAppender">
    <file>${LOG_FILE}</file>
    <append>true</append>
    <immediateFlush>true</immediateFlush>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Root logger at INFO using BOTH appenders -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>